@page
@model Universidade.Mongo.Pages.Cursos.IndexModel
@{
    ViewData["Title"] = "Cursos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Cursos</h1>
    <a class="btn btn-primary" asp-page="Criar">+ Novo curso</a>
</div>

@if (Model.UltimoComando is not null)
{
    <partial name="_ComandoPanel" model="Model.UltimoComando" />
}

<form method="get" class="d-flex gap-2 mb-3">
    <input class="form-control" name="busca" value="@Model.Busca" placeholder="Buscar por nome" />
    <button class="btn btn-outline-secondary" type="submit">Buscar</button>
    @if (!string.IsNullOrEmpty(Model.Busca))
    {
        <a class="btn btn-outline-secondary" asp-page="Index">Limpar</a>
    }
</form>

<p class="text-muted">@Model.Cursos.Count documento(s) em <code>db.cursos</code></p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>_id</th>
                <th>Nome</th>
                <th>Grau</th>
                <th>Turno</th>
                <th>Campus</th>
                <th>Nível</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Cursos)
            {
                <tr class="@(c.Id.ToString() == Model.Destaque ? "destaque" : "")">
                    <td><code>@c.Id</code></td>
                    <td>@c.Nome</td>
                    <td>@c.Grau</td>
                    <td>@c.Turno</td>
                    <td>@c.Campus</td>
                    <td>@c.Nivel</td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-page="Editar" asp-route-id="@c.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-page="Excluir" asp-route-id="@c.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
