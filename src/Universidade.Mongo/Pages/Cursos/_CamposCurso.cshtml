@model CursoForm

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Grau" class="form-label"></label>
        <select asp-for="Grau" class="form-select" asp-items="Dominios.GrauCurso.ParaSelect(Model.Grau)">
            <option value="">(nenhum)</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="Turno" class="form-label"></label>
        <select asp-for="Turno" class="form-select" asp-items="Dominios.TurnoCurso.ParaSelect(Model.Turno)">
            <option value="">Selecione...</option>
        </select>
        <span asp-validation-for="Turno" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Nivel" class="form-label"></label>
        <select asp-for="Nivel" class="form-select" asp-items="Dominios.NivelCurso.ParaSelect(Model.Nivel)">
            <option value="">(nenhum)</option>
        </select>
    </div>
    <div class="col-md-6">
        <label asp-for="Campus" class="form-label"></label>
        <input asp-for="Campus" class="form-control" />
    </div>
</div>
