@model VinculoForm
@{
    var estudantes = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["Estudantes"]!;
    var cursos = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["Cursos"]!;
}

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="MatEstudante" class="form-label"></label>
        <select asp-for="MatEstudante" asp-items="estudantes" class="form-select">
            <option value="">Selecione...</option>
        </select>
        <span asp-validation-for="MatEstudante" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Curso" class="form-label"></label>
        <select asp-for="Curso" asp-items="cursos" class="form-select">
            <option value="">Selecione...</option>
        </select>
        <span asp-validation-for="Curso" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DataEntrada" class="form-label"></label>
        <input asp-for="DataEntrada" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Dominios.StatusVinculo.ParaSelect(Model.Status)">
            <option value="">(nenhuma)</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="DataSaida" class="form-label"></label>
        <input asp-for="DataSaida" class="form-control" />
    </div>
</div>
