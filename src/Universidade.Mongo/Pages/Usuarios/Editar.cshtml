@page "{cpf}"
@model Universidade.Mongo.Pages.Usuarios.EditarModel
@{
    ViewData["Title"] = "Editar usuário";
    ViewData["Edicao"] = true;
}

<h1 class="mb-3">Editar usuário <code>@Model.Cpf</code></h1>

@if (Model.UltimoComando is not null)
{
    <partial name="_ComandoPanel" model="Model.UltimoComando" />
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <partial name="_CamposUsuario" for="Form" view-data="ViewData" />

    <p class="text-muted small mt-3">
        Alterar o CPF muda o <code>_id</code> do documento. Diferente do relacional (que tinha
        <code>ON UPDATE CASCADE</code>), o MongoDB não propaga isso para o estudante que referencia
        esse CPF — é preciso atualizar manualmente.
    </p>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
