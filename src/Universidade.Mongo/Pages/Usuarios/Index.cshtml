@page
@model Universidade.Mongo.Pages.Usuarios.IndexModel
@{
    ViewData["Title"] = "Usuários";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Usuários</h1>
    <a class="btn btn-primary" asp-page="Criar">+ Novo usuário</a>
</div>

@if (Model.UltimoComando is not null)
{
    <partial name="_ComandoPanel" model="Model.UltimoComando" />
}

<form method="get" class="d-flex gap-2 mb-3">
    <input class="form-control" name="busca" value="@Model.Busca" placeholder="Buscar por nome, login ou CPF" />
    <button class="btn btn-outline-secondary" type="submit">Buscar</button>
    @if (!string.IsNullOrEmpty(Model.Busca))
    {
        <a class="btn btn-outline-secondary" asp-page="Index">Limpar</a>
    }
</form>

<p class="text-muted">@Model.Usuarios.Count documento(s) em <code>db.usuarios</code></p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>CPF (_id)</th>
                <th>Nome</th>
                <th>Nascimento</th>
                <th>E-mails</th>
                <th>Telefones</th>
                <th>Login</th>
                <th>Senha</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Usuarios)
            {
                <tr class="@(u.Cpf == Model.Destaque ? "destaque" : "")">
                    <td><code>@u.Cpf</code></td>
                    <td>@u.Nome</td>
                    <td>@u.DataNascimento?.ToString("dd/MM/yyyy")</td>
                    <td>@(u.Email is null ? "" : string.Join(", ", u.Email))</td>
                    <td>@(u.Telefone is null ? "" : string.Join(", ", u.Telefone))</td>
                    <td>@u.Login</td>
                    <td class="senha-mascarada">@(u.Senha is null ? "" : "••••")</td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-page="Editar" asp-route-cpf="@u.Cpf">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-page="Excluir" asp-route-cpf="@u.Cpf">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
