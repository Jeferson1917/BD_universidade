@page "{mat}"
@model Universidade.Mongo.Pages.Estudantes.EditarModel
@{
    ViewData["Title"] = "Editar estudante";
    ViewData["Edicao"] = true;
}

<h1 class="mb-3">Editar estudante <code>@Model.Mat</code></h1>

@if (Model.UltimoComando is not null)
{
    <partial name="_ComandoPanel" model="Model.UltimoComando" />
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <partial name="_CamposEstudante" for="Form" view-data="ViewData" />

    <p class="text-muted small mt-3">
        O array <code>planos</code> (embutido, mapeado de <code>universidade.plano</code>) não é editado
        aqui e é mantido como está.
    </p>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
