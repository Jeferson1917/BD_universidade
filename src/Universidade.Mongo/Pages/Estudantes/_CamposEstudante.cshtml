@model EstudanteForm
@{
    var edicao = ViewData["Edicao"] is true;
}

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="MatEstudante" class="form-label"></label>
        <input asp-for="MatEstudante" class="form-control" readonly="@edicao" />
        <span asp-validation-for="MatEstudante" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Cpf" class="form-label"></label>
        <input asp-for="Cpf" class="form-control" inputmode="numeric" placeholder="11 dígitos (opcional)" />
        <span asp-validation-for="Cpf" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="AnoIngresso" class="form-label"></label>
        <input asp-for="AnoIngresso" class="form-control" />
        <span asp-validation-for="AnoIngresso" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Mc" class="form-label"></label>
        <input asp-for="Mc" class="form-control" step="0.1" />
        <span asp-validation-for="Mc" class="text-danger small"></span>
    </div>
</div>
