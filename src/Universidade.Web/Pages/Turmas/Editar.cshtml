@page "{id:int}"
@model Universidade.Web.Pages.Turmas.EditarModel
@{
    ViewData["Title"] = "Editar turma";
}

<h1 class="mb-3">Editar turma <code>@Model.Id</code></h1>

@if (Model.UltimoComando is not null)
{
    <partial name="_SqlPanel" model="Model.UltimoComando" />
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <partial name="_CamposTurma" for="Form" view-data="ViewData" />

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
