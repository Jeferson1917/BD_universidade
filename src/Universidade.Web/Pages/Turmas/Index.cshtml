@page
@model Universidade.Web.Pages.Turmas.IndexModel
@{
    ViewData["Title"] = "Turmas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Turmas</h1>
    <a class="btn btn-primary" asp-page="Criar">+ Nova turma</a>
</div>

@if (Model.UltimoComando is not null)
{
    <partial name="_SqlPanel" model="Model.UltimoComando" />
}

<form method="get" class="d-flex gap-2 mb-3">
    <input class="form-control" name="busca" value="@Model.Busca" placeholder="Buscar por id, código ou nome da disciplina" />
    <button class="btn btn-outline-secondary" type="submit">Buscar</button>
    @if (!string.IsNullOrEmpty(Model.Busca))
    {
        <a class="btn btn-outline-secondary" asp-page="Index">Limpar</a>
    }
</form>

<details class="mb-3">
    <summary class="text-muted">Consulta usada nesta listagem</summary>
    <pre class="sql mt-2">@TurmaRepository.SqlListar</pre>
    <p class="small text-muted">
        <code>@@busca</code> = @(string.IsNullOrWhiteSpace(Model.Busca) ? "NULL" : $"'%{Model.Busca.Trim()}%'")
    </p>
</details>

<p class="text-muted">@Model.Turmas.Count registro(s)</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Disciplina</th>
                <th>Número</th>
                <th>Semestre</th>
                <th>Professores (leciona)</th>
                <th class="text-end">Alunos</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Turmas)
            {
                <tr class="@(t.IdTurma.ToString() == Model.Destaque ? "destaque" : "")">
                    <td><code>@t.IdTurma</code></td>
                    <td><code>@t.CodDisc</code> @t.NomeDisciplina</td>
                    <td>@t.Numero</td>
                    <td>@t.SemestreTexto</td>
                    <td>@(t.Professores ?? "—")</td>
                    <td class="text-end">@t.Alunos</td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-page="Editar" asp-route-id="@t.IdTurma">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-page="Excluir" asp-route-id="@t.IdTurma">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
