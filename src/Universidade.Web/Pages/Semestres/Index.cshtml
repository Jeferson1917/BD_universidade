@page
@model Universidade.Web.Pages.Semestres.IndexModel
@{
    ViewData["Title"] = "Semestres";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Semestres</h1>
    <a class="btn btn-primary" asp-page="Criar">+ Novo semestre</a>
</div>

@if (Model.UltimoComando is not null)
{
    <partial name="_SqlPanel" model="Model.UltimoComando" />
}

<details class="mb-3">
    <summary class="text-muted">Consulta usada nesta listagem</summary>
    <pre class="sql mt-2">@SemestreRepository.SqlListar</pre>
</details>

<p class="text-muted">@Model.Semestres.Count registro(s)</p>

<table class="table table-striped table-hover align-middle w-auto">
    <thead>
        <tr>
            <th>Ano</th>
            <th>Semestre</th>
            <th>Início</th>
            <th>Fim</th>
            <th class="text-end">Turmas</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.Semestres)
        {
            <tr class="@(s.Chave == Model.Destaque ? "destaque" : "")">
                <td>@s.Ano</td>
                <td>@s.Periodo</td>
                <td>@s.DataInicio?.ToString("dd/MM/yyyy")</td>
                <td>@s.DataFim?.ToString("dd/MM/yyyy")</td>
                <td class="text-end">@s.Turmas</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-page="Editar" asp-route-ano="@s.Ano" asp-route-semestre="@s.Periodo">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-page="Excluir" asp-route-ano="@s.Ano" asp-route-semestre="@s.Periodo">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
