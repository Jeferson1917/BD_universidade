@page "{cpf:long}"
@model Universidade.Web.Pages.Usuarios.ExcluirModel
@{
    ViewData["Title"] = "Excluir usuário";
    var u = Model.Usuario!;
}

<h1 class="mb-3">Excluir usuário</h1>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">CPF</dt>
            <dd class="col-sm-9"><code>@u.CpfFormatado</code></dd>
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@u.Nome</dd>
            <dt class="col-sm-3">Nascimento</dt>
            <dd class="col-sm-9">@u.DataNascimento?.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">E-mails</dt>
            <dd class="col-sm-9">@(u.Email is null ? "" : string.Join(", ", u.Email))</dd>
            <dt class="col-sm-3">Telefones</dt>
            <dd class="col-sm-9">@(u.Telefone is null ? "" : string.Join(", ", u.Telefone))</dd>
            <dt class="col-sm-3">Login</dt>
            <dd class="col-sm-9">@u.Login</dd>
        </dl>
    </div>
</div>

@if (Model.MatProfessor is not null || Model.MatEstudante is not null)
{
    <div class="alert alert-warning">
        <strong>Atenção:</strong> este usuário está ligado a
        @if (Model.MatProfessor is not null)
        {
            <span>professor <code>@Model.MatProfessor</code></span>
        }
        @if (Model.MatProfessor is not null && Model.MatEstudante is not null)
        {
            <span> e </span>
        }
        @if (Model.MatEstudante is not null)
        {
            <span>estudante <code>@Model.MatEstudante</code></span>
        }.
        A chave estrangeira usa <code>ON DELETE SET NULL</code>: o registro não será apagado,
        mas ficará com <code>cpf = NULL</code>.
    </div>
}

<pre class="sql">DELETE FROM universidade.usuario
WHERE cpf = @u.Cpf</pre>

<form method="post" class="d-flex gap-2">
    <button type="submit" class="btn btn-danger">Confirmar exclusão</button>
    <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
</form>
