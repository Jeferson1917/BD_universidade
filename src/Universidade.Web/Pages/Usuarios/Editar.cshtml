@page "{cpf:long}"
@model Universidade.Web.Pages.Usuarios.EditarModel
@{
    ViewData["Title"] = "Editar usuário";
    ViewData["Edicao"] = true;
}

<h1 class="mb-3">Editar usuário <code>@Model.Cpf.ToString("00000000000")</code></h1>

@if (Model.UltimoComando is not null)
{
    <partial name="_SqlPanel" model="Model.UltimoComando" />
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <partial name="_CamposUsuario" for="Form" view-data="ViewData" />

    <p class="text-muted small mt-3">
        Alterar o CPF muda a chave primária. As tabelas professor e estudante referenciam o CPF com
        <code>ON UPDATE CASCADE</code>, então o novo valor é propagado automaticamente.
    </p>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
