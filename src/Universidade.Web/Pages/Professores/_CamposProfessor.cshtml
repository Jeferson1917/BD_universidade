@model ProfessorForm
@{
    var usuarios = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["Usuarios"]!;
    var departamentos = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["Departamentos"]!;
    var formacoes = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["Formacoes"]!;
    var jornadas = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["Jornadas"]!;
}

<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="MatProfessor" class="form-label"></label>
        <input asp-for="MatProfessor" class="form-control" placeholder="ex.: P1600" />
        <span asp-validation-for="MatProfessor" class="text-danger small"></span>
    </div>
    <div class="col-md-9">
        <label asp-for="Cpf" class="form-label"></label>
        <select asp-for="Cpf" asp-items="usuarios" class="form-select">
            <option value="">(nenhum — cpf NULL)</option>
        </select>
        <div class="form-text">
            Só aparecem usuários que ainda não são professores (cpf é UNIQUE em professor).
            Para um usuário novo, cadastre-o antes em <a asp-page="/Usuarios/Criar">Usuários</a>.
        </div>
    </div>
    <div class="col-md-6">
        <label asp-for="Departamento" class="form-label"></label>
        <select asp-for="Departamento" asp-items="departamentos" class="form-select">
            <option value="">(nenhum)</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="Formacao" class="form-label"></label>
        <select asp-for="Formacao" asp-items="formacoes" class="form-select">
            <option value="">(nenhuma)</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="TipoJornada" class="form-label"></label>
        <select asp-for="TipoJornada" asp-items="jornadas" class="form-select">
            <option value="">(nenhuma)</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="DataAdmissao" class="form-label"></label>
        <input asp-for="DataAdmissao" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Salario" class="form-label"></label>
        <input asp-for="Salario" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Salario" class="text-danger small"></span>
    </div>
</div>
